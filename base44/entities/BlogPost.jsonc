{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Blog post title"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "cover_image": {
      "type": "string",
      "description": "Cover image URL"
    },
    "excerpt": {
      "type": "string",
      "description": "Short summary of the post"
    },
    "content": {
      "type": "string",
      "description": "Full blog post content (markdown or HTML)"
    },
    "author": {
      "type": "string",
      "description": "Author name"
    },
    "category": {
      "type": "string",
      "enum": [
        "ABA Therapy",
        "Speech Therapy",
        "Occupational Therapy",
        "Parent Tips",
        "Special Education",
        "General"
      ],
      "default": "General",
      "description": "Blog post category"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for the post"
    },
    "published": {
      "type": "boolean",
      "default": false,
      "description": "Whether the post is publicly visible"
    },
    "published_date": {
      "type": "string",
      "format": "date",
      "description": "Date the post was published"
    }
  },
  "required": [
    "title",
    "content"
  ]
}